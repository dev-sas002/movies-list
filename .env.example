# Copy to .env next to docker-compose.yml. Compose reads it automatically.

# Required. Generate one with: openssl rand -base64 48
JWT_SECRET=

# Optional overrides (defaults shown).
# SEED_EMAIL=test@example.com
# SEED_PASSWORD=password123
# CORS_ORIGINS=http://localhost:8290
# PUBLIC_API_URL=http://localhost:8291
# MAX_UPLOAD_BYTES=5242880
# LIST_CACHE_TTL_MS=30000

# Optional: switches search to the AI planner. Unset means rule-based.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
