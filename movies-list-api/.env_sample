# Copy to .env and fill in. `.env` is git-ignored.
PORT=3001
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=movie-list

# Required. Generate one with: openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-string

# Optional
CORS_ORIGINS=*
MAX_UPLOAD_BYTES=5242880
LIST_CACHE_TTL_MS=30000

# Optional: enables AI-assisted natural-language search.
# Without it the rule-based query planner is used and search still works.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
